# ──────────────────────────────────────────────────────────
# MYSQL
# ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=hsts_db
MYSQL_USER=hsts_user
MYSQL_PASSWORD=changeme_user

# ──────────────────────────────────────────────────────────
# BACKEND — ASP.NET Core (injected as environment variables)
# ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long
JWT_ISSUER=HSTS.API
JWT_AUDIENCE=HSTS.FE
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30

# Production: https://hangout.io.vn | Test: http://localhost or your test domain
CORS_ALLOWED_ORIGIN=https://hangout.io.vn

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@your-domain.com
RESEND_FROM_NAME=Hangout - Smart Travel System

# Public frontend origin used in backend-generated email links.
CLIENT_APP_BASE_URL=https://hangout.io.vn

# Google OAuth — MUST match VITE_GOOGLE_OAUTH_CLIENT_ID below
GOOGLE_CLIENT_ID=your-google-oauth-client-id

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

EMAIL_POLICY_ALLOW_VN_DOMAINS=true
EMAIL_POLICY_ALLOWED_DOMAIN_0=gmail.com
EMAIL_POLICY_ALLOWED_DOMAIN_1=googlemail.com
EMAIL_POLICY_ALLOWED_DOMAIN_2=outlook.com
EMAIL_POLICY_ALLOWED_DOMAIN_3=hotmail.com
EMAIL_POLICY_ALLOWED_DOMAIN_4=live.com
EMAIL_POLICY_ALLOWED_DOMAIN_5=msn.com
EMAIL_POLICY_ALLOWED_DOMAIN_6=yahoo.com
EMAIL_POLICY_ALLOWED_DOMAIN_7=ymail.com
EMAIL_POLICY_ALLOWED_DOMAIN_8=rocketmail.com
EMAIL_POLICY_ALLOWED_DOMAIN_9=icloud.com
EMAIL_POLICY_ALLOWED_DOMAIN_10=me.com
EMAIL_POLICY_ALLOWED_DOMAIN_11=mac.com
EMAIL_POLICY_ALLOWED_DOMAIN_12=proton.me
EMAIL_POLICY_ALLOWED_DOMAIN_13=protonmail.com
EMAIL_POLICY_ALLOWED_DOMAIN_14=pm.me
EMAIL_POLICY_ALLOWED_DOMAIN_15=zoho.com
EMAIL_POLICY_ALLOWED_DOMAIN_16=zohomail.com
EMAIL_POLICY_ALLOWED_DOMAIN_17=aol.com
EMAIL_POLICY_ALLOWED_DOMAIN_18=gmx.com
EMAIL_POLICY_ALLOWED_DOMAIN_19=gmx.net
EMAIL_POLICY_ALLOWED_DOMAIN_20=mail.com
EMAIL_POLICY_ALLOWED_DOMAIN_21=yandex.com
EMAIL_POLICY_ALLOWED_DOMAIN_22=yandex.ru
EMAIL_POLICY_ALLOWED_DOMAIN_23=qq.com
EMAIL_POLICY_ALLOWED_DOMAIN_24=163.com
EMAIL_POLICY_ALLOWED_DOMAIN_25=126.com
EMAIL_POLICY_ALLOWED_DOMAIN_26=doralove.xyz
EMAIL_POLICY_ALLOWED_DOMAIN_27=helloworldxyz.qzz.io
EMAIL_POLICY_ALLOWED_DOMAIN_28=doralover.qzz.io
EMAIL_POLICY_ALLOWED_DOMAIN_29=toibingoo.click

EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6/
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_CACHE_MINUTES=60

TRAVEL_ROUTE_PROVIDER=OSRM
TRAVEL_ROUTE_BASE_URL=https://router.project-osrm.org/
TRAVEL_ROUTE_ENDPOINT_PATH=route/v1/driving
TRAVEL_ROUTE_DEFAULT_QUERY_STRING=overview=false&alternatives=false&steps=false
TRAVEL_ROUTE_API_KEY=
TRAVEL_ROUTE_API_KEY_HEADER_NAME=

TRAVEL_WEATHER_PROVIDER=OpenMeteo
TRAVEL_WEATHER_BASE_URL=https://api.open-meteo.com/
TRAVEL_WEATHER_ENDPOINT_PATH=v1/forecast
TRAVEL_WEATHER_DEFAULT_QUERY_STRING=daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto
TRAVEL_WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/
TRAVEL_WEATHER_GEOCODING_ENDPOINT_PATH=v1/search
TRAVEL_WEATHER_API_KEY=
TRAVEL_WEATHER_API_KEY_HEADER_NAME=

TRAVEL_SANDBOX_BASE_URL=https://your-sandbox-api-host
TRAVEL_SANDBOX_ENDPOINT_PATH=search
TRAVEL_SANDBOX_API_KEY=your-sandbox-api-key
TRAVEL_SANDBOX_API_KEY_HEADER_NAME=X-API-Key

TRAVEL_FIXED_INTERCITY_BASE_URL=https://transport-api.helloworld.io.vn/
TRAVEL_FIXED_INTERCITY_BUS_ENDPOINT_PATH=transport/bus
TRAVEL_FIXED_INTERCITY_TRAIN_ENDPOINT_PATH=transport/train
TRAVEL_FIXED_INTERCITY_TRAIN_MONTHLY_COUNT_ENDPOINT_PATH=transport/train/calendar-count
TRAVEL_FIXED_INTERCITY_PLANE_ENDPOINT_PATH=transport/plane
TRAVEL_FIXED_INTERCITY_PLANE_MONTHLY_COUNT_ENDPOINT_PATH=transport/plane/calendar-count
TRAVEL_FIXED_INTERCITY_API_KEY=your-shared-transport-api-key
TRAVEL_FIXED_INTERCITY_API_KEY_HEADER_NAME=X-API-Key

# ──────────────────────────────────────────────────────────
# FRONTEND — baked into the JS bundle at Docker build time
# Changing these requires rebuilding the frontend image.
# ──────────────────────────────────────────────────────────
VITE_APP_NAME=Hangout - Smart Travel System
VITE_TIMEOUT=10000

# Leave empty so axios uses relative paths (/api/...) via nginx.
# Set to https://hangout.io.vn if you need an absolute URL.
VITE_API_BASE_URL=

VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key

# MUST be the same value as GOOGLE_CLIENT_ID above
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id

# Used by direct Cloudinary upload for location images.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ──────────────────────────────────────────────────────────
# TEST ENVIRONMENT ONLY
# ──────────────────────────────────────────────────────────
# Port to expose MySQL on the host for direct DB access.
# Default 3307 avoids conflict with any local MySQL on 3306.
MYSQL_EXPOSED_PORT=3307
