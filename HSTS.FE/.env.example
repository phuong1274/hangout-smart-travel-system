# GLOBAL CONFIGURATION
VITE_APP_NAME="Hangout - Smart Travel System"
VITE_TIMEOUT=10000

# API ENDPOINTS
# Leave empty to use Vite dev proxy (avoids cross-origin cookie issues in Edge/Firefox)
# The proxy forwards /api/* to https://localhost:7139 — see vite.config.js
VITE_API_BASE_URL=

# THIRD-PARTY SERVICES 
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_CLOUDINARY_CLOUD_NAME=
